{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Awesome AI Agents catalog",
  "type": "object",
  "required": ["meta", "categories"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "updated"],
      "properties": {
        "title": {"type": "string"},
        "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "repo": {"type": "string"},
        "homepage": {"type": "string"}
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "emoji", "sections"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string"},
          "emoji": {"type": "string"},
          "description": {"type": "string"},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["entries"],
              "properties": {
                "title": {"type": "string"},
                "blurb": {"type": "string"},
                "entries": {"type": "array", "items": {"$ref": "#/definitions/entry"}}
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "description", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string"},
        "repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
        "url": {"type": "string", "pattern": "^https?://"},
        "npm": {"type": "string"},
        "pypi": {"type": "string"},
        "description": {"type": "string", "minLength": 20, "maxLength": 300},
        "kind": {"enum": ["oss", "commercial", "spec", "paper", "resource", "dataset", "model", "infra"]},
        "oneline": {"type": "string"},
        "license": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"},
        "version": {"type": "string"},
        "note": {"type": "string"},
        "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}